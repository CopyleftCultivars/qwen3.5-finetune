  "proposal_file": "data/recipe_mapping_derivations_proposal_v1.json",
  "owner_signoff": {
    "status": "approved_by_owner",
    "date": "2026-10-17",
    "source": "Chainlink issue #56 owner decisions comment, 2026-10-17",
    "scope": "recipe-to-plant mappings and the derived candidate policy only",
    "decisions": [
      {
        "id": "nutrient_scope",
        "decision": "The recipe tool computes N, P and K; Ca stays out of scope for v2 and WCA is not computable."
      },
      {
        "id": "trifolium_repens",
        "decision": "Accept Trifolium repens (Clover) as Red Clover (Trifolium pratense), the only clover in the catalog.",
        "caveat": "species proxy: the recipe names white clover, the profile is red clover"
      },
      {
        "id": "citrus_peel",
        "decision": "Citrus peel resolves to a citrus group the user picks from; the eight Citrus profiles stay visible as candidates."
      },
      {
        "id": "angelica_archangelica",
        "decision": "Angelica archangelica uses the closest of the three Angelica profiles; v2 records Angelica dahurica as closest by scientific-name similarity."
      },
